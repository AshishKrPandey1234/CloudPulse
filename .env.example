# ===================================================================
# CloudPulse Environment Variables Configuration Template
# Copy this file to .env and adjust variables as required
# ===================================================================

# Docker Hub Image Configuration
DOCKER_IMAGE=ashishkrpandey1234/cloudpulse:latest

# MySQL Database Credentials
DB_NAME=cloudpulse_db
DB_USER=cloudpulse_user
DB_PASS=cloudpulse_pass_secure_2026
DB_ROOT_PASS=root_secure_password_2026

# Grafana Dashboard Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secure_password_2026

# Server Port Configuration
APP_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
MYSQL_PORT=3306
